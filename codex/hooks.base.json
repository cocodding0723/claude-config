{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 __HOME__/.codex/hooks/claude-compat.py",
            "timeout": 35
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 __HOME__/.codex/hooks/claude-compat.py",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 __HOME__/.codex/hooks/claude-compat.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 __HOME__/.codex/hooks/claude-compat.py",
            "timeout": 150
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 __HOME__/.codex/hooks/claude-compat.py",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 __HOME__/.codex/hooks/claude-compat.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
