<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.lrm.panelcollect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.config/lrm-hubs/panel_collect.sh</string>
    <string>--once</string>
  </array>
  <key>StartInterval</key><integer>90</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/.config/lrm-hubs/panel-collect.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.config/lrm-hubs/panel-collect.log</string>
</dict>
</plist>
