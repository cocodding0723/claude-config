<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.lrm.reviewbatch</string>
  <!-- 답 처리 → 모아 올리기, 실패·고칠 점 경고 보고는 review_batch_run.sh 가 함 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>__HOME__/.config/lrm-hubs/review_batch_run.sh</string>
  </array>
  <!-- 실행 시각은 여기 한 곳. 기본 매일 18:00 -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <!-- launchd 기본 PATH 에 bd(brew)가 없음. python3 는 install.sh 가 3.10 이상으로 검증한 경로 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>LRM_PYTHON3</key><string>__PYTHON3__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/.config/lrm-hubs/review-batch.launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.config/lrm-hubs/review-batch.launchd.log</string>
</dict>
</plist>
