<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.lrm.nightinbox</string>
  <!-- 밤사이 막힌 확인 요청을 아침에 보고 1건으로. 야간 창 끝(night_policy.tsv window_end 7시) 직후. 비어 있으면 아무것도 안 보냄 -->
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON3__</string>
    <string>-I</string>
    <string>__HOME__/.config/lrm-hubs/night_inbox_report.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/.config/lrm-hubs/night-inbox.launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.config/lrm-hubs/night-inbox.launchd.log</string>
</dict>
</plist>
