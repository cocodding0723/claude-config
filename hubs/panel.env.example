# 옆 패널 수집기(panel_collect.sh) 설정 양식. 쓰려면 ~/.config/lrm-hubs/panel.env 로 복사해 채움(없어도 동작).
# 시크릿 아님. 수집기는 아래 키만 KEY=값 으로 읽고 파일을 실행하지 않음. 같은 이름의 환경 변수가 있으면 그쪽이 우선.
# 열린 PR·CI 실패 수를 셀 저장소. 공백·쉼표로 구분한 owner/repo. 비우면 gh 를 부르지 않음
PANEL_GH_REPOS=
# gh 호출 간격 초(기본 300 = 5분, 60~86400). 수집 주기(90초)마다 부르지 않게 함
PANEL_GH_INTERVAL=300
# 허브 폴더 상위 경로. 비우면 작업 폴더 이름이 coord-* 인 터미널을 모두 허브로 봄
PANEL_HUB_ROOT=
# 최근 종료 작업 건수(기본 5, 1~20)
PANEL_RECENT=5
# 홈 볼륨 여유가 이 GB 미만이면 쉬는 자원 칸에 경고(기본 50)
PANEL_DISK_MIN_GB=50
# 크기를 잴 워크스페이스 폴더(기본 ~/orca/workspaces). du 는 느려 PANEL_DU_INTERVAL 초마다만 잼(기본 1800)
PANEL_WS_DIR=
PANEL_DU_INTERVAL=1800
# du 시간 상한 초(기본 120, 1~600). 넘기면 du 를 끝내고 직전 값 + "측정 시간 초과" 표시
PANEL_DU_TIMEOUT=120
