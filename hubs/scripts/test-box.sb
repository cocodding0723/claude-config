; 격리 시험 실행기(test-box)의 상자 규칙. 뒤 줄이 앞 줄보다 우선함
; 목적: 작업 공간의 시험이 무엇을 하든 승인 기록·운영 폴더를 못 고치고, 실제 Slack 에 못 닿고, 비밀 파일을 못 읽게 함
; 막지 않는 것: 이 컴퓨터 안의 포트(localhost) 연결. 가짜 서버가 임의 포트를 쓰기 때문이며, 세션의 일반 셸도 할 수 있는 일임
(version 1)
(allow default)

; 쓰기는 상자(임시 폴더 하나) 안에만. 사용자 임시 폴더 전체는 열지 않음(다른 도구의 작업물이 있음)
(deny file-write*)
(allow file-write* (subpath (param "BOX")) (literal "/dev/null") (literal "/dev/tty") (literal "/dev/dtracehelper") (regex #"^/dev/fd/"))
; bash 3.2 는 heredoc 임시 파일을 TMPDIR 과 무관하게 /var/tmp/sh-thd-숫자 로 만듦. 그 이름만 허용(폴더 자체는 쓰기 가능 여부 확인에 필요)
(allow file-write* (literal "/private/var/tmp") (regex #"^/private/var/tmp/sh-thd-[0-9]+$"))
; /usr/bin 의 python3·git 은 Xcode 대리 실행 파일이라 사용자 임시 폴더에 찾기 캐시(xcrun_db)를 씀. 못 쓰면 경고가 출력에 섞여 시험이 깨짐. 그 이름만 허용
(allow file-write* (regex #"^/private/var/folders/[^/]+/[^/]+/T/xcrun_db(-[A-Za-z0-9]+)?$"))

; 밖으로 나가는 연결은 이 컴퓨터 안의 포트와 상자 안에 만든 유닉스 소켓만. 다른 프로세스의 제어 소켓(편집기·ssh-agent)은 막음
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*") (subpath (param "BOX")))

; 신호는 같은 상자 안 프로세스(시험이 띄운 가짜 서버)에만
(deny signal)
(allow signal (target same-sandbox))

; 상주 작업 등록·다른 앱 조종 도구는 실행 못 함
(deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/osascript"))

; 비밀 파일은 상자 안에 시험이 만든 가짜만 읽음
(deny file-read-data (regex #"\.(env|pem|keystore)$") (regex #"/\.ssh/"))
(allow file-read-data (subpath (param "BOX")))
; 공개 인증서 묶음은 비밀이 아니고 HTTPS 준비(가짜 서버 호출 전 단계)에 필요함
(allow file-read-data (regex #"/(cacert|cert)\.pem$"))
