#!/bin/bash
# Unity 실행 래퍼. 슬롯은 실행 직전에만 받고 종료 시 반드시 반납(미리 잡기·반납 누수 방지)
set -u
SLOT_SH="${LRM_UNITY_SLOT_SH:-$(cd "$(dirname "$0")" && pwd)/unity_slot.sh}"
# 부하 기준 기본값 = 코어 수 × 1.5(15코어 ≈ 22). 고정 12 는 병렬 작업 중 상시 초과라 슬롯을 못 받았음(11-16 실측 부하 23)
CORES=$(sysctl -n hw.ncpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 8)
NAME="unity"; LOAD_MAX="${LRM_LOAD_MAX:-$(awk -v c="$CORES" 'BEGIN{printf "%.1f", c*1.5}')}"; KEEP="${LRM_LOAD_KEEP_WAITING:-0}"; LOAD_TIMEOUT="${LRM_LOAD_TIMEOUT:-1800}"; LOAD_POLL="${LRM_LOAD_POLL:-15}"

usage() {
  cat <<'H'
사용: unity-run [--name <허브:작업>] [--load-max N] [--load-timeout 초] [--keep-waiting] -- <Unity 실행 명령…>
  부하(1분 평균)가 N(기본 코어 수×1.5) 이하가 될 때까지 기다린 뒤 슬롯을 받고 명령을 실행, 끝나면 반납.
  --keep-waiting: 대기 시간을 넘겨도 실패하지 않고 경고만 남기며 계속 기다림.
  LRM_SLOT_PRIORITY=1 이면 대기열 맨 앞. 슬롯 수는 LRM_UNITY_SLOTS(unity_slot.sh 기본값).
환경: LRM_UNITY_SLOT_DIR(슬롯 상태 위치) LRM_LOAD_MAX(코어×1.5) LRM_LOAD_KEEP_WAITING(0) LRM_LOAD_TIMEOUT(1800) LRM_LOAD_POLL(15)
      LRM_LOADAVG_CMD(부하 조회 명령, 기본 sysctl -n vm.loadavg)
종료: 명령의 종료 코드 그대로 / 2 사용법 오류 / 3 부하 대기 초과(--keep-waiting 없을 때)·슬롯 획득 실패
예:
  unity-run --name qa:editmode -- "$UNITY" -batchmode -projectPath "$WS" -runTests -testPlatform EditMode
  LRM_SLOT_PRIORITY=1 unity-run --name ui:render -- bash render.sh
H
}

while [ $# -gt 0 ]; do
  case "$1" in
    --name) NAME="${2:?--name 값 필요}"; shift 2 ;;
    --load-max) LOAD_MAX="${2:?--load-max 값 필요}"; shift 2 ;;
    --load-timeout) LOAD_TIMEOUT="${2:?--load-timeout 값 필요}"; shift 2 ;;
    --keep-waiting) KEEP=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "오류: 알 수 없는 인자 '$1'. 명령 앞에 -- 필요. 예: unity-run --name a:b -- sleep 1" >&2; exit 2 ;;
  esac
done
[ $# -gt 0 ] || { echo "오류: 실행할 명령 없음. 예: unity-run --name a:b -- \"\$UNITY\" -batchmode …" >&2; exit 2; }

load1() {
  if [ -n "${LRM_LOADAVG_CMD:-}" ]; then sh -c "$LRM_LOADAVG_CMD"; else sysctl -n vm.loadavg | awk '{print $2}'; fi
}

waited=0
while :; do
  L=$(load1)
  awk -v l="$L" -v m="$LOAD_MAX" 'BEGIN{exit !(l<=m)}' && break
  if [ "$waited" -ge "$LOAD_TIMEOUT" ]; then
    if [ "$KEEP" != 1 ]; then
      echo "오류: 부하 $L > $LOAD_MAX 상태가 ${LOAD_TIMEOUT}초 지속. 다른 Unity·빌드 종료 후 재실행하거나 --keep-waiting·--load-timeout 사용" >&2
      exit 3
    fi
    echo "경고: 부하 $L > $LOAD_MAX 상태가 ${LOAD_TIMEOUT}초 지속. 계속 기다림(--keep-waiting)" >&2
    waited=0
  fi
  echo "부하 $L > $LOAD_MAX, ${LOAD_POLL}초 뒤 재확인 (${waited}/${LOAD_TIMEOUT}초)" >&2
  sleep "$LOAD_POLL"; waited=$((waited + LOAD_POLL))
done

export LRM_SLOT_OWNER_PID=$$
S=""; CHILD=""
release() {
  [ -n "$S" ] || return 0
  # 자기 소유 슬롯만 반납. 이미 회수돼 다른 작업이 받은 슬롯은 건드리지 않음
  d="${LRM_UNITY_SLOT_DIR:-/tmp/lrm-unity-slots}/slot-$S"
  [ "$(cat "$d/pid" 2>/dev/null)" = "$$" ] && bash "$SLOT_SH" release "$S" >&2
  S=""
}
stop() {
  [ -n "$CHILD" ] && kill -TERM "$CHILD" 2>/dev/null && wait "$CHILD" 2>/dev/null
  exit 130
}
trap release EXIT
trap stop INT TERM

S=$(bash "$SLOT_SH" acquire "$NAME") || { echo "오류: 슬롯 획득 실패. 'bash $SLOT_SH status' 로 확인" >&2; S=""; exit 3; }
echo "slot-$S 획득: $NAME" >&2
"$@" &
CHILD=$!
echo "$CHILD" > "${LRM_UNITY_SLOT_DIR:-/tmp/lrm-unity-slots}/slot-$S/child"
wait "$CHILD"; RC=$?
CHILD=""
exit "$RC"
