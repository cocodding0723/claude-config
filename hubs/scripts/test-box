#!/bin/bash
# 격리 시험 실행기. 시험 스크립트를 상자(임시 폴더) 안에서만 쓰게 묶어 실행함.
# 왜: 보호 훅은 승인 기록 이름이 든 작업 공간 스크립트의 실행을 막음(시험이 그 이름의 가짜 파일을 만들기 때문).
#     여기서는 운영체제가 상자 밖 쓰기를 막으므로, 병합 전 시험도 사용자 손을 빌리지 않고 돌릴 수 있음.
# 상자 규칙은 옆의 test-box.sb 한 곳.
set -u
usage() {
  cat >&2 <<'U'
사용법: test-box [--keep] <시험 스크립트> [인자…]
  시험을 임시 폴더 안에서만 쓰게 묶어 실행. 임시 폴더 밖 쓰기, 바깥 네트워크, 비밀 파일 읽기는 막힘
  --keep   끝난 뒤 임시 폴더를 남기고 경로를 알림(실패 원인 볼 때)
예: test-box tests/test_pending.sh
    board-run test --card <카드> --actor <이름> -- test-box tests/test_pending.sh
종료 코드: 시험의 종료 코드 그대로 / 2 사용법 오류 / 4 격리할 수 없음(시험을 돌리지 않음)
U
  exit 2
}
KEEP=0
while [ $# -gt 0 ]; do
  case "$1" in
    --keep) KEEP=1; shift ;;
    -h|--help) usage ;;
    -*) echo "모르는 옵션: $1" >&2; usage ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || usage
TARGET="$1"; shift
[ -f "$TARGET" ] || { echo "시험 스크립트 없음: $TARGET — 경로를 확인할 것" >&2; exit 2; }

SELF="$(cd "$(dirname "$0")" && pwd -P)"
SB="/usr/bin/sandbox-exec"; RULES="$SELF/test-box.sb"
[ -x "$SB" ] && [ -f "$RULES" ] || { echo "격리 도구 없음($SB 또는 $RULES) — 시험을 돌리지 않음. install.sh 를 다시 실행할 것" >&2; exit 4; }
NAME="test-box"
no_box() { echo "임시 폴더를 못 만듦 — 시험을 돌리지 않음" >&2; exit 4; }
# 만들기가 실패하면 빈 값으로 cd 해 현재 폴더를 상자로 착각할 수 있음(끝날 때 지움). 단계마다 확인하고 이름까지 대조
MADE="$(mktemp -d "${TMPDIR:-/tmp}/$NAME.XXXXXX" 2>/dev/null)" && [ -n "$MADE" ] && [ -d "$MADE" ] || no_box
BOX="$(cd "$MADE" && pwd -P)" || no_box
case "$(basename "$BOX")" in "$NAME".??????) ;; *) no_box ;; esac
clean() { if [ "$KEEP" -eq 1 ]; then echo "상자 남김: $BOX" >&2; else rm -rf "$BOX"; fi; }
trap clean EXIT
USERTMP="$(cd "$(getconf DARWIN_USER_TEMP_DIR)" 2>/dev/null && pwd -P)" || USERTMP="$BOX"  # mktemp 가 쓰는 곳
BOXARGS=(-f "$RULES" -D BOX="$BOX" -D USERTMP="$USERTMP")
# 상자가 실제로 씌워지는지 먼저 확인. 안 되면 격리 없이 돌리지 않고 멈춤
"$SB" "${BOXARGS[@]}" /usr/bin/true 2>/dev/null || { echo "상자를 씌울 수 없음($RULES 문법 또는 운영체제 제한) — 시험을 돌리지 않음" >&2; exit 4; }

case "$TARGET" in *.py) RUN=(python3) ;; *) RUN=(/bin/bash) ;; esac
TMPDIR="$BOX" LRM_TEST_BOX=1 "$SB" "${BOXARGS[@]}" "${RUN[@]}" "$TARGET" "$@"
