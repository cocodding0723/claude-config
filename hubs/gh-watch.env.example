# GitHub PR·CI 감시기(gh_watch.py) 조절값 양식. 쓰려면 ~/.config/lrm-hubs/gh-watch.env 로 복사(없으면 기본값).
# 시크릿 아님. KEY=값 만 읽고 실행하지 않음. 같은 이름 환경 변수가 우선. 저장소 목록은 panel.env 의 PANEL_GH_REPOS 를 씀.
# 평소 간격 초 / 내 PR 실행이 진행 중일 때 간격 초
GH_WATCH_IDLE=60
GH_WATCH_BUSY=20
# 데스크톱 알림 시간당 상한(내 PR CI 실패·남이 병합한 PR 만 알림)
GH_WATCH_NOTIFY_PER_HOUR=6
# 잠·끊김 뒤 따라잡을 때 목록당 최대 쪽 수(pulls 20개·runs 30개 단위)
GH_WATCH_PAGES=5
# 후속 명령(gh-watch-actions.json) 시간 상한 초
GH_WATCH_ACTION_TIMEOUT=60
