#!/usr/bin/env python3
"""기능 카드(epic)의 작업 단계를 옮기거나 지금 단계를 보여 줌. 단계·크기·계획 승인 규칙은 lib/board_flow.py 한 곳.
단계를 카드에 적어 두면 사용자와 옆 패널이 어디까지 왔는지 보고, 집기 도구가 같은 규칙으로 구현 착수를 막음."""
import argparse
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import board_flow as bf  # noqa: E402

EPILOG = """\
단계: 0 접수(intake) → 1 이해(understand) → 2 설계(design) → 3 구현(build) → 4 검증(verify) → 5 검수(review) → 6 반영(ship)
  이름은 영문·한글·번호 모두 받음. 5·6 은 손으로 옮기지 않음(완료 검사 board-done --epic 과 사용자 검수 답이 옮김).
새 흐름 기능(label flow:v1)의 조건:
  접수를 떠나려면 기능 카드 설명에 '- 목표: …' 와 '- 확인 방법: …' 줄이 있고 크기(--size)가 정해져 있어야 함.
  구현·검증으로 가려면 크기가 작음이거나, 계획 승인 카드에 사용자가 Slack 에서 승인으로 답했어야 함.
  되돌아가기(예: 검증 → 구현, 구현 → 설계)는 같은 조건으로 언제나 됨.
옛 방식 기능(flow:v1 없음)은 단계 표시만 하고 막지 않음.

종료 코드: 0 옮김(또는 조회) · 2 사용법·카드 없음·기능 카드 아님·접수 칸이나 크기 없음·손으로 못 옮기는 단계 · 4 환경(bd 실패) · 15 계획 승인 전
예:
  board-stage lrm-spn                         지금 단계·크기·계획 승인 여부
  board-stage lrm-spn understand feat-mail --size normal --note "기획 대조 시작"
  board-stage lrm-spn build feat-mail
환경: BOARD_DIR(기본 ~/orca/board) LRM_HUB_DIR(기본 ~/.config/lrm-hubs, 계획 승인 답을 읽는 곳)"""


SIZE_ORDER = (bf.SMALL, bf.NORMAL, bf.LARGE)  # 작은 것부터. 낮추기 판정에 씀


def die(msg, code):
    print(msg, file=sys.stderr)
    sys.exit(code)


def bd(*args, actor=None):
    env = dict(os.environ, BD_ACTOR=actor) if actor else None
    return subprocess.run(["bd", *args], capture_output=True, text=True, env=env)


def show(card_id):
    r = bd("show", card_id, "--json")
    try:
        d = json.loads(r.stdout or "null")
    except ValueError:
        d = None
    return d[0] if isinstance(d, list) and d else d


def current(epic):
    """카드에 적힌 단계(없으면 None). 여러 개가 붙어 있으면 가장 뒤 단계"""
    have = [s for s in bf.STAGES if s.label in bf.labels(epic)]
    return have[-1] if have else None


def main():
    ap = argparse.ArgumentParser(prog="board-stage", description="기능 카드의 작업 단계 옮기기·보기.",
                                 epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("card", help="기능 카드(epic) id")
    ap.add_argument("stage", nargs="?", help="옮길 단계. 생략하면 지금 상태만 보여 줌")
    ap.add_argument("actor", nargs="?", help="작업자 이름(BD_ACTOR). 단계를 옮길 때 필요")
    ap.add_argument("--size", help=f"작업 크기 {'|'.join(bf.SIZES)}. 접수에서 정함")
    ap.add_argument("--user-said", default="", metavar="원문", help="크기를 낮출 때 필요: 그렇게 하라고 한 사용자 원문. 카드 코멘트에 남음")
    ap.add_argument("--note", default="", help="단계 코멘트에 붙일 한 줄")
    ap.add_argument("--json", action="store_true", help="결과를 JSON 한 줄로")
    try:
        a = ap.parse_args()
    except SystemExit as e:
        sys.exit(0 if e.code == 0 else 2)

    board = os.environ.get("BOARD_DIR", os.path.expanduser("~/orca/board"))
    if not os.path.isdir(board):
        die(f"실패: 작업판 폴더 {board} 없음. 조치: BOARD_DIR=<경로> board-stage …", 4)
    os.chdir(board)
    hub = os.environ.get("LRM_HUB_DIR") or os.path.expanduser("~/.config/lrm-hubs")
    epic = show(a.card)
    if not epic:
        die(f"거부: 카드 {a.card} 없음. 조치: bd list -t epic 으로 id 확인", 2)
    if epic.get("issue_type") != "epic":
        die(f"거부: {a.card} 는 기능 카드(epic)가 아님. 조치: 단계는 기능 카드에 적음 — 상위 카드 id 로 다시 실행", 2)
    did = bf.plan_id(epic["id"])
    approved = lambda d: bf.plan_approved(hub, d)  # noqa: E731

    if a.stage is None:
        st, size = current(epic), bf.size_of(epic)
        out = {"card": epic["id"], "stage": st.key if st else "", "size": size, "flow": bf.FLOW_LABEL in bf.labels(epic),
               "plan_id": did, "plan_approved": approved(did), "intake_gaps": bf.intake_gaps(epic.get("description") or "")}
        if a.json:
            print(json.dumps(out, ensure_ascii=False))
        else:
            where = f"{bf.order(st)} {st.name}" if st else "정해지지 않음"
            print(f"단계: {where}\n크기: {bf.SIZES.get(size, '정해지지 않음')}\n계획 승인: {'됨' if out['plan_approved'] else '안 됨'} ({did})")
            if out["intake_gaps"]:
                print(f"비어 있는 접수 칸: {', '.join(out['intake_gaps'])}")
        return

    if not a.actor:
        die("거부: 작업자 이름 필요. 조치: board-stage <기능 카드> <단계> <작업자>", 2)
    if a.size is not None and a.size not in bf.SIZES:
        die(f"거부: 모르는 크기 '{a.size}'. 조치: --size {'|'.join(bf.SIZES)} 중 하나", 2)
    if bf.stage("review").label in bf.labels(epic):
        die(f"거부: {a.card} 는 사용자 검수 대기 중. 조치: 수정 요청은 수정 카드로 처리하고, 검수가 끝나면 board-done --epic {a.card} <이름> --user-ok \"<원문>\"", 2)

    # 크기를 낮추면 계획 승인을 건너뛰게 됨(작음은 설계를 건너뜀). 코디네이터 혼자 낮추지 못하게 사용자 원문을 요구하고 카드에 남김
    was = bf.size_of(epic)
    lowered = bool(a.size and was and SIZE_ORDER.index(a.size) < SIZE_ORDER.index(was))
    if lowered and not a.user_said.strip():
        die(f"거부: 크기를 {bf.SIZES[was]}에서 {bf.SIZES[a.size]}로 낮추려면 사용자 확인이 필요. "
            f"조치: 사용자에게 확인받고 --user-said \"<사용자 원문>\" 을 함께 줌(작음은 계획 승인을 건너뛰기 때문)", 2)

    planned = dict(epic)
    if a.size:  # 크기를 이번에 정하는 경우: 그 크기로 판정한 뒤 통과하면 카드에 적음
        planned["labels"] = [x for x in bf.labels(epic) if not x.startswith(bf.SIZE_HEAD)] + [bf.SIZE_HEAD + a.size]
    why = bf.stage_block(planned, a.stage, lambda d: True)   # 계획 승인과 무관한 이유부터
    if why:
        die(f"거부: {why}", 2)
    why = bf.stage_block(planned, a.stage, approved)
    if why:
        die(f"거부: {why}", 15)

    st = bf.stage(a.stage)
    steps = []  # 새 label 을 먼저 붙이고 옛 것을 뗌: 중간에 실패해도 단계·크기 표시가 비지 않음
    if a.size and a.size != was:
        steps.append(("label", "add", epic["id"], bf.SIZE_HEAD + a.size))
        steps += [("label", "remove", epic["id"], x) for x in bf.labels(epic) if x.startswith(bf.SIZE_HEAD) and x != bf.SIZE_HEAD + a.size]
        if was:
            said = f" (사용자 원문: {a.user_said.strip()})" if lowered else ""
            steps.append(("comments", "add", epic["id"], f"크기 변경: {bf.SIZES[was]} → {bf.SIZES[a.size]}{said}"))
    if st.label not in bf.labels(epic):
        steps.append(("label", "add", epic["id"], st.label))
    steps += [("label", "remove", epic["id"], s.label) for s in bf.STAGES if s.label in bf.labels(epic) and s.key != st.key]
    steps.append(("comments", "add", epic["id"], f"단계: {bf.order(st)} {st.name}" + (f" — {a.note}" if a.note else "")))
    for step in steps:
        r = bd(*step, actor=a.actor)
        if r.returncode != 0:
            die(f"실패: bd {' '.join(step[:2])} {r.stderr.strip()[:200]}. 조치: 같은 명령을 다시 실행(이미 된 단계는 건너뜀)", 4)
    if a.json:
        print(json.dumps({"card": epic["id"], "stage": st.key, "size": a.size or bf.size_of(epic)}, ensure_ascii=False))
    else:
        print(f"단계: {epic['id']} → {bf.order(st)} {st.name}")


if __name__ == "__main__":
    main()
