#!/usr/bin/env python3
"""작업판 카드 완료 게이트. 카드 종류별 증거를 검사한 뒤에만 bd close 함."""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import board_evidence as bev  # noqa: E402
import board_scope as bs  # noqa: E402
import board_config  # noqa: E402

USAGE_EPILOG = """\
증거는 카드 notes 나 코멘트에 한 줄씩 단다. 로그는 board-run 으로 만든다(마지막 줄에 붙일 증거 줄을 출력함):
  evidence:compile=<board-run compile 로그>   '# exit 0', error CS 줄 0
  evidence:editmode=<board-run editmode --result 로그 또는 NUnit xml>   total·passed ≥1, failed 0, 전부 건너뜀 아님
  evidence:test=<board-run test 로그>         label kind:tool 카드(Unity 없는 도구 저장소)만. '# exit 0'
board-run 로그는 머리줄 tree= 가 브랜치 끝 커밋의 tree 와 같아야 함(시험 → 커밋 순서도 인정). 손으로 쓴 로그·빈 로그는 거부.
  evidence:mapping=<대응표 md>          시안 카드만. "연결 기능" 빈 칸 0
  evidence:prefab-diff=<비교 결과>      시안 카드만. 불일치 0
  evidence:screenshot=<png>  evidence:recording=<mp4>   --epic 만
  evidence:review=<판정 json>          --epic 만. {"verdict":"pass","reviewer_model":..,"author_model":..} 두 모델이 달라야 함
증거 줄 끝에 commit=<해시> 를 붙여 어느 커밋의 증거인지 묶는다. 카드 label branch:<브랜치>·repo:<저장소 경로> 가 필요하고,
해시가 그 브랜치 끝과 같아야 하며 파일은 그 커밋 시각 이후에 만들어져야 함(낡은 증거·다른 커밋 증거 거부).
게이트 컴파일: <BOARD_DIR>/repos.json 의 그 저장소 "compile"(또는 BOARD_COMPILE_CMD)이 있으면 게이트가 repo 에서 직접 컴파일을 돌려
compile 증거를 만든다(작업자 로그 대신 씀). 설정이 없으면 경고만 내고 작업자 로그를 검사함. 양식: board/repos.example.json
epic 이 닫히면 label stage:review(사용자 검수 대기)를 붙임. 기능 코디네이터는 이때 정리하지 않음: 검수 답(통과·고칠 점)을 받을 세션이 있어야 함.
  검수 통과:  board-done --epic <id> <이름> --user-ok "<사용자 원문>"   → stage:review 를 떼고 stage:ship(반영 중)을 붙임
  반영 끝:    board-done --epic <id> <이름> --shipped "<PR 번호·병합 커밋>" → stage:ship 을 떼고, label feature:<slug> 가 있으면
              BOARD_FEATURE_CLOSE(기본 ~/.config/lrm-hubs/feature_close.sh) --slug <slug> --yes 를 분리 실행해 기능 코디네이터를 정리함(BOARD_FEATURE_CLOSE=off 로 끔)
같은 종류가 여럿이면 마지막 줄(notes 다음 코멘트 순)만 봄. '<종류>=' 를 생략하면 파일 이름으로 추정함. 모든 파일은 존재·비어 있지 않음·카드 claim 이후 수정이어야 함.

카드 종류: label kind:mockup → 시안 카드, kind:tool → 도구 카드(test 증거), 그 외 → 일반 카드.

예:
  board-done bd-12 ui-worker
  board-done bd-12 ui-worker --dry-run --json
  board-done --epic bd-3 coordinator

종료 코드:
  0 닫음·이미 닫힘(또는 --dry-run 통과)  2 사용법  3 환경(bd 없음·작업판 폴더 없음)  4 카드 없음·상태 불일치
  5 작업자 불일치  6 증거 누락  7 증거 내용 불합격  8 bd close 실패
"""

EXIT_OK, EXIT_USAGE, EXIT_ENV, EXIT_STATE, EXIT_ACTOR, EXIT_MISSING, EXIT_INVALID, EXIT_CLOSE = 0, 2, 3, 4, 5, 6, 7, 8

REQUIRED = {
    "task": ["compile", "editmode"],
    "tool": ["test"],
    "mockup": ["compile", "editmode", "mapping", "prefab-diff"],
    "epic": ["screenshot", "recording", "review"],
}

GUESS = bev.GUESS

EMPTY_CELL = {"", "-", "—", "미정", "todo", "tbd", "?"}
RUN_HEAD = re.compile(r"^# board-run kind=(\S+) tree=([0-9a-f]{40}) head=(\S+)", re.M)
EVIDENCE_RE = bev.EVIDENCE_RE


class Fail(Exception):
    def __init__(self, code, cause, fix):
        super().__init__(cause)
        self.code, self.cause, self.fix = code, cause, fix


def bd(*args, actor=None):
    env = dict(os.environ)
    if actor:
        env["BD_ACTOR"] = actor
    return subprocess.run(["bd", *args], capture_output=True, text=True, env=env, stdin=subprocess.DEVNULL)


def bd_json(*args):
    r = bd(*args, "--json")
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return None


def parse_time(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def load_card(card_id):
    d = bd_json("show", card_id)
    if not d:
        raise Fail(EXIT_STATE, f"카드 {card_id} 를 찾지 못함", "bd list 로 id 확인. BOARD_DIR 가 맞는 작업판인지 확인")
    return d[0] if isinstance(d, list) else d


def collect_evidence(card):
    texts = [card.get("notes") or ""]
    for c in bd_json("comments", card["id"]) or []:
        texts.append(c.get("text") or "")
    return bev.parse(texts)


def git(repo, *args):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def branch_head(card):
    """(repo, 브랜치, 끝 해시, 커밋 시각). label 이 없거나 브랜치를 못 읽으면 Fail"""
    repo, branch = os.path.expanduser(bs.label(card, "repo")), bs.label(card, "branch")
    if branch and card.get("parent") and not (repo and git(repo, "rev-parse", "--verify", "-q", branch + "^{commit}")):
        # 작업 공간이 반납돼 repo: 폴더가 없으면 epic 의 repo:(주 저장소)에서 브랜치를 읽음
        epic = bd_json("show", card["parent"]) or []
        epic = epic[0] if isinstance(epic, list) and epic else epic or {}
        repo = os.path.expanduser(bs.label(epic, "repo")) or repo
    if not repo or not branch:
        raise Fail(EXIT_MISSING, f"{card['id']} 에 branch:·repo: label 없음(증거를 커밋에 묶을 수 없음)",
                   f"bd label add {card['id']} branch:<브랜치> && bd label add {card['id']} repo:<저장소 경로>")
    head = git(repo, "rev-parse", "--verify", "-q", branch + "^{commit}")
    if not head:
        raise Fail(EXIT_ENV, f"{repo} 에서 브랜치 {branch} 를 못 읽음", "repo:·branch: label 확인")
    return repo, branch, head, float(git(repo, "show", "-s", "--format=%ct", head) or 0)


def unrecorded_merges(epic, kids):
    """epic 통합 브랜치(base:..branch:)의 첫 부모 병합 중 board-merge 기록이 없는 것. 기준 브랜치 받아오기 병합은 제외.
    epic 에 base: label 이 없으면 검사 못 함(빈 목록)"""
    repo, branch, base = os.path.expanduser(bs.label(epic, "repo")), bs.label(epic, "branch"), bs.label(epic, "base")
    if not (repo and branch and base) or not git(repo, "rev-parse", "--verify", "-q", base):
        return []
    recorded = set()
    for k in kids:
        for c in bd_json("comments", k["id"]) or []:
            t = (c.get("text") or "").split()
            if len(t) >= 2 and t[0] == "board-merge:":
                recorded.add(t[1])
    out = []
    for m in git(repo, "rev-list", "--first-parent", "--merges", f"{base}..{branch}").split():
        side = git(repo, "rev-parse", m + "^2")
        if not side or subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", side, base]).returncode == 0:
            continue
        if not any(m.startswith(r) or r.startswith(m) for r in recorded):
            out.append(m)
    return out


def check_commit(sha, head, branch):
    if not sha:
        return "증거 줄에 commit=<해시> 없음"
    if not head.startswith(sha):
        return f"증거 커밋 {sha[:12]} 가 {branch} 끝 {head[:12]} 와 다름(낡은 증거)"
    return None


def gate_compile(card, repo, head, warnings):
    """저장소 설정 compile(또는 BOARD_COMPILE_CMD)을 repo 에서 board-run 으로 실행해 증거 로그를 만든다. repo 의 HEAD 가 브랜치 끝이어야 함"""
    cmd = os.environ.get("BOARD_COMPILE_CMD") or board_config.get(repo, "compile")
    if not cmd:
        warnings.append(f"{bs.repo_id(repo) or repo} 의 게이트 컴파일 설정 없음 → 작업자 board-run 로그만 검사. 켜기: {board_config.path()} 에 \"compile\"(양식 board/repos.example.json)")
        return None
    if git(repo, "rev-parse", "HEAD") != head:
        raise Fail(EXIT_STATE, f"{repo} 의 HEAD 가 브랜치 끝 {head[:12]} 가 아님(게이트 컴파일 불가)", f"git -C {repo} checkout <브랜치> 뒤 다시 실행")
    os.makedirs(".evidence", exist_ok=True)
    log = os.path.abspath(os.path.join(".evidence", f"{card['id']}-compile-{head[:12]}.log"))
    run = os.path.join(os.path.dirname(os.path.realpath(__file__)), "board-run")
    subprocess.run([run, "compile", "--out", log, "--", "bash", "-c", cmd], cwd=repo, capture_output=True, text=True)
    return log


def check_file(path, since):
    if not os.path.isfile(path):
        return f"{path} 없음"
    if os.path.getsize(path) == 0:
        return f"{path} 비어 있음"
    if not runlog(path) and os.path.getmtime(path) < since:
        return f"{path} 가 카드 claim 이전에 수정됨(낡은 증거)"
    return None


def runlog(path):
    """board-run 로그 해석. 아니면 None. {kind, tree, head, exit(int|None), results:[(경로, sha256)]}"""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            first = f.readline()
            if not first.startswith("# board-run "):
                return None
            text = first + f.read()
    except OSError:
        return None
    m = RUN_HEAD.match(text)
    if not m:
        return None
    ex = re.findall(r"^# exit (-?\d+)\s*$", text, re.M)
    res = re.findall(r"^# result (\S+) sha256=([0-9a-f]{64})\s*$", text, re.M)
    return {"kind": m.group(1), "tree": m.group(2), "head": m.group(3), "exit": int(ex[-1]) if ex else None,
            "results": res, "text": text}


def check_run(path, kind, tree):
    """board-run 로그가 그 종류·브랜치 끝 내용으로 끝까지 돌아 종료 0 이었는지"""
    rl = runlog(path)
    if not rl:
        return f"{path} 가 board-run 로그가 아님(손으로 쓴 로그 거부). board-run {kind} -- <명령> 으로 다시 만듦"
    if rl["kind"] != kind:
        return f"{path} 는 board-run {rl['kind']} 로그(필요: {kind})"
    if rl["tree"] != tree:
        return f"{path} 는 다른 내용(tree {rl['tree'][:12]})에서 돌린 결과. 브랜치 끝 tree {tree[:12]} 에서 다시 실행"
    if rl["exit"] is None:
        return f"{path} 에 '# exit' 줄 없음(중간에 끊긴 실행)"
    if rl["exit"] != 0:
        return f"{path} 명령 종료 {rl['exit']}"
    return None


def read(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def check_compile(path, tree):
    errs = [l for l in read(path).splitlines() if re.search(r"\berror CS\d+", l)]
    if errs:
        return f"{path} 에 컴파일 오류 {len(errs)}줄: {errs[0].strip()[:160]}"
    return check_run(path, "compile", tree)


def check_test(path, tree):
    return check_run(path, "test", tree)


def check_xml(path):
    text = read(path)
    m = re.search(r"<test-run\b[^>]*>", text)
    if not m:
        return f"{path} 가 NUnit 결과 xml 이 아님(<test-run> 없음)"
    head = m.group(0)
    num = lambda k: int(re.search(rf'\b{k}="(\d+)"', head).group(1)) if re.search(rf'\b{k}="(\d+)"', head) else None
    total, passed, failed = num("total"), num("passed"), num("failed")
    if total is None or passed is None:
        return f"{path} <test-run> 에 total·passed 없음(형식만 맞춘 결과 거부)"
    if (failed or 0) != 0 or re.search(r'\bresult="Failed', head):
        return f"{path} 실패한 시험 있음(failed={failed if failed is not None else '?'})"
    if total == 0 or passed == 0:
        return f"{path} 통과한 시험 0개(total={total}, passed={passed}. 전부 건너뜀·필터 불일치)"
    return None


def check_editmode(path, tree):
    """NUnit xml 직접(claim 이후 수정) 또는 board-run editmode --result 로그(내용·sha256 묶음)"""
    rl = runlog(path)
    if not rl:
        return check_xml(path)
    err = check_run(path, "editmode", tree)
    if err:
        return err
    if not rl["results"]:
        return f"{path} 에 '# result <xml> sha256=' 줄 없음. board-run editmode --result <xml> -- … 로 다시 실행"
    xml, sha = rl["results"][-1]
    if not os.path.isfile(xml):
        return f"{xml} 없음(로그 {path} 가 가리킴)"
    import hashlib
    with open(xml, "rb") as f:
        if hashlib.sha256(f.read()).hexdigest() != sha:
            return f"{xml} 가 실행 뒤 바뀜(sha256 불일치)"
    return check_xml(xml)


def check_mapping(path):
    rows = [l.strip() for l in read(path).splitlines() if l.strip().startswith("|")]
    header = next((r for r in rows if "연결 기능" in r), None)
    if not header:
        return f"{path} 에 '연결 기능' 열이 있는 대응표 없음"
    cells = lambda r: [c.strip() for c in r.strip("|").split("|")]
    col = next(i for i, c in enumerate(cells(header)) if "연결 기능" in c)
    body = [r for r in rows[rows.index(header) + 1:] if not re.fullmatch(r"[|\s:\-]+", r)]
    body = [r for r in body if not cells(r)[0].startswith("예)")]
    if not body:
        return f"{path} 대응표에 행 없음"
    empty = [cells(r)[0] for r in body if len(cells(r)) <= col or cells(r)[col].lower() in EMPTY_CELL]
    if empty:
        return f"{path} 연결 기능 빈 행 {len(empty)}개: {', '.join(empty[:5])}"
    return None


def check_review(path):
    try:
        d = json.loads(read(path))
    except json.JSONDecodeError:
        return f"{path} 가 JSON 아님"
    if not isinstance(d, dict):
        return f"{path} 가 JSON 객체 아님"
    rev, auth = (str(d.get(k) or "").strip().lower() for k in ("reviewer_model", "author_model"))
    if not rev or not auth:
        return f"{path} 에 reviewer_model·author_model 없음"
    if rev == auth:
        return f"{path} 검수 모델이 구현 모델과 같음({rev})"
    if str(d.get("verdict", "")).lower() != "pass":
        return f"{path} 판정 {d.get('verdict')!r}(pass 아님): {str(d.get('reasons', ''))[:160]}"
    return None


def check_prefab_diff(path):
    text = read(path)
    try:
        d = json.loads(text)
        n = d.get("mismatches") if isinstance(d, dict) else None
        n = len(n) if isinstance(n, list) else n
        if n is None:
            return f"{path} JSON 에 mismatches 필드 없음"
        return f"{path} 프리팹 값 불일치 {n}건" if n else None
    except json.JSONDecodeError:
        bad = [l for l in text.splitlines() if re.match(r"\s*(MISMATCH|불일치|FAIL)\b", l, re.I)]
        return f"{path} 프리팹 값 불일치 {len(bad)}건: {bad[0].strip()[:160]}" if bad else None


CONTENT = {
    "compile": check_compile,
    "editmode": check_editmode,
    "test": check_test,
    "mapping": lambda p, _t: check_mapping(p),
    "prefab-diff": lambda p, _t: check_prefab_diff(p),
    "review": lambda p, _t: check_review(p),
}

FIX = {
    "compile": "board-run compile -- <컴파일 명령> 을 브랜치 끝에서 돌려 출력된 evidence:compile=… 줄 추가",
    "editmode": "board-run editmode --result <xml> -- <EditMode 명령> 을 돌려 출력된 evidence:editmode=… 줄 추가",
    "test": "board-run test -- <시험 명령> 을 브랜치 끝에서 돌려 출력된 evidence:test=… 줄 추가",
    "mapping": "templates/card-mockup.md 의 대응표를 채우고 evidence:mapping=<경로> 추가",
    "prefab-diff": "프리팹 값 비교를 돌려 결과를 남기고 evidence:prefab-diff=<경로> 추가",
    "screenshot": "기능 묶음 화면을 촬영하고 evidence:screenshot=<png> 추가",
    "recording": "기능 묶음 녹화를 남기고 evidence:recording=<mp4> 추가",
    "review": "구현과 다른 모델이 판정 json 을 쓰고 evidence:review=<경로> commit=<해시> 추가",
}


def gate(card, actor, epic, warnings):
    if epic and card.get("issue_type") != "epic":
        raise Fail(EXIT_STATE, f"{card['id']} 는 epic 이 아님(issue_type={card.get('issue_type')})", "--epic 없이 다시 실행")
    if not epic and card.get("issue_type") == "epic":
        raise Fail(EXIT_STATE, f"{card['id']} 는 epic", "board-done --epic 으로 실행")
    assignee = card.get("assignee") or ""
    if not epic and card.get("status") != "in_progress":
        raise Fail(EXIT_STATE, f"{card['id']} 상태가 {card.get('status')}(집지 않음)", f"board-claim {card['id']} {actor} 뒤 작업")
    if assignee and assignee != actor:
        raise Fail(EXIT_ACTOR, f"{card['id']} 담당은 {assignee}, 요청 작업자는 {actor}", "담당 작업자 이름으로 실행하거나 담당자를 바꿈")

    if epic:
        kids = bd_json("children", card["id"]) or []
        open_kids = [k["id"] for k in kids if k.get("status") != "closed"]
        if open_kids:
            raise Fail(EXIT_STATE, f"하위 카드 {len(open_kids)}개 안 닫힘: {', '.join(open_kids[:5])}", "하위 카드를 board-merge 로 먼저 닫음")
        direct = [k["id"] for k in kids if not str(k.get("close_reason") or "").startswith("board-done:")]
        if direct:
            raise Fail(EXIT_STATE, f"하위 카드 {len(direct)}개가 완료 게이트 없이 닫힘(bd close 직접): {', '.join(direct[:5])}",
                       "bd reopen <id> 뒤 board-merge <id> <작업자> 로 다시 닫음")
        stray = unrecorded_merges(card, kids)
        if stray:
            raise Fail(EXIT_STATE, f"통합 브랜치에 board-merge 기록 없는 병합 {len(stray)}개: {', '.join(m[:12] for m in stray[:5])}",
                       "직접 git merge 한 카드 브랜치를 board-merge <카드> <작업자> 로 다시 실행(범위·증거 검사 뒤 기록됨)")
        kind = "epic"
    else:
        labs = card.get("labels") or []
        kind = "mockup" if "kind:mockup" in labs else "tool" if "kind:tool" in labs else "task"

    repo, branch, head, head_time = branch_head(card)
    tree = git(repo, "rev-parse", head + "^{tree}")
    since = max(parse_time(card.get("started_at") or card["created_at"]), head_time)
    found = collect_evidence(card)
    if "compile" in REQUIRED[kind]:
        log = gate_compile(card, repo, head, warnings)
        if log:
            found.setdefault("compile", []).append((log, head))
    checks = []
    for need in REQUIRED[kind]:
        # 같은 종류는 마지막 줄만 봄. 틀린 증거를 지우지 않고 새 줄로 바로잡게 함
        paths = found.get(need, [])[-1:]
        if not paths:
            checks.append({"kind": need, "ok": False, "code": EXIT_MISSING, "cause": f"evidence:{need} 줄 없음", "fix": FIX[need]})
            continue
        for p, sha in paths:
            err = check_commit(sha, head, branch)
            if err:
                err = f"{need}: {err}"
            else:
                err = check_file(p, since)
            code = EXIT_MISSING if err else EXIT_INVALID
            if not err and need in CONTENT:
                err = CONTENT[need](p, tree)
            checks.append({"kind": need, "path": p, "ok": not err, **({"code": code, "cause": err, "fix": FIX[need]} if err else {})})
    return kind, checks


def spawn_feature_close(card):
    """반영이 끝난 뒤 기능 코디네이터 정리를 분리 실행. 코디네이터 터미널이 닫혀도 끝까지 돌게 새 세션으로 띄움"""
    slug = bs.label(card, "feature")
    script = os.environ.get("BOARD_FEATURE_CLOSE", os.path.expanduser("~/.config/lrm-hubs/feature_close.sh"))
    if not slug or script == "off":
        return "건너뜀"
    if not os.path.isfile(script):
        return f"건너뜀: {script} 없음"
    log = os.path.abspath(os.path.join(".evidence", f"{card['id']}-feature-close.log"))
    os.makedirs(".evidence", exist_ok=True)
    with open(log, "a") as f:
        subprocess.Popen(["bash", script, "--slug", slug, "--yes"], stdout=f, stderr=f, stdin=subprocess.DEVNULL, start_new_session=True)
    return f"실행: {script} --slug {slug} --yes (로그 {log})"


def main():
    ap = argparse.ArgumentParser(
        prog="board-done",
        description="작업판 카드 완료 게이트. 증거 검사를 통과해야만 BD_ACTOR=<작업자> 로 bd close 함.",
        epilog=USAGE_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("card_id", help="카드 id")
    ap.add_argument("actor", help="카드를 집은 작업자 이름(BD_ACTOR 로 씀)")
    ap.add_argument("--epic", action="store_true", help="기능 묶음(epic) 완료. 하위 카드 전부 닫힘 + 화면 촬영·녹화 요구")
    ap.add_argument("--dry-run", action="store_true", help="검사만 하고 닫지 않음")
    ap.add_argument("--user-ok", default=None, metavar="원문", help="--epic: 사용자 검수 통과 원문. stage:review 를 떼고 stage:ship 을 붙이며 원문을 남김")
    ap.add_argument("--shipped", default=None, metavar="근거", help="--epic: 반영이 끝난 근거(PR 번호·병합 커밋). stage:ship 을 떼고 기능 코디네이터를 정리함")
    ap.add_argument("--json", action="store_true", help="결과를 JSON 한 개로 stdout 에 출력")
    try:
        a = ap.parse_args()
    except SystemExit as e:
        sys.exit(EXIT_OK if e.code == 0 else EXIT_USAGE)

    out = {"id": a.card_id, "actor": a.actor, "epic": a.epic, "dry_run": a.dry_run}
    board = os.environ.get("BOARD_DIR", os.path.expanduser("~/orca/board"))
    try:
        if not shutil.which("bd"):
            raise Fail(EXIT_ENV, "bd 명령 없음", "brew install beads 또는 PATH 확인")
        if not os.path.isdir(board):
            raise Fail(EXIT_ENV, f"작업판 폴더 {board} 없음", "BOARD_DIR=<작업판 경로> board-done <id> <작업자>")
        os.chdir(board)
        card = load_card(a.card_id)
        if a.user_ok is not None:
            if not a.epic or not a.user_ok.strip():
                raise Fail(EXIT_USAGE, "--user-ok 는 --epic 과 사용자 원문이 필요", 'board-done --epic <id> <이름> --user-ok "<원문>"')
            if "stage:review" not in (card.get("labels") or []):
                raise Fail(EXIT_STATE, f"{a.card_id} 는 검수 대기(stage:review)가 아님", "board-done --epic 으로 먼저 닫음")
            bd("comments", "add", a.card_id, f"user-ok: {a.user_ok}", actor=a.actor)
            bd("label", "add", a.card_id, "stage:ship", actor=a.actor)  # 새 label 먼저: 중간에 실패해도 단계 표시가 비지 않음(답 전달이 이 표시로 살아 있는 기능을 가림)
            bd("label", "remove", a.card_id, "stage:review", actor=a.actor)
            out.update(ok=True, closed=False, user_ok=True, exit=EXIT_OK)
            print(json.dumps(out, ensure_ascii=False) if a.json else f"검수 통과 기록: {a.card_id} → 반영 단계. 병합이 끝나면 board-done --epic {a.card_id} {a.actor} --shipped \"<PR·병합 커밋>\"")
            sys.exit(EXIT_OK)
        if a.shipped is not None:
            if not a.epic or not a.shipped.strip():
                raise Fail(EXIT_USAGE, "--shipped 는 --epic 과 반영 근거가 필요", 'board-done --epic <id> <이름> --shipped "<PR 번호·병합 커밋>"')
            if "stage:ship" not in (card.get("labels") or []):
                raise Fail(EXIT_STATE, f"{a.card_id} 는 반영 단계(stage:ship)가 아님", '검수 통과를 먼저 기록: board-done --epic <id> <이름> --user-ok "<원문>"')
            bd("comments", "add", a.card_id, f"shipped: {a.shipped}", actor=a.actor)
            bd("label", "remove", a.card_id, "stage:ship", actor=a.actor)
            out.update(ok=True, closed=False, shipped=True, exit=EXIT_OK, feature_close=spawn_feature_close(card))
            print(json.dumps(out, ensure_ascii=False) if a.json else f"반영 끝 기록: {a.card_id} · 코디네이터 정리 {out['feature_close']}")
            sys.exit(EXIT_OK)
        if card.get("status") == "closed":
            out.update(ok=True, closed=False, already=True, exit=EXIT_OK)
            print(json.dumps(out, ensure_ascii=False) if a.json else f"이미 닫힘: {a.card_id}")
            sys.exit(EXIT_OK)
        warnings = []
        kind, checks = gate(card, a.actor, a.epic, warnings)
        out.update(kind=kind, checks=checks, warnings=warnings)
        for w in warnings if not a.json else []:
            print(f"경고: {w}", file=sys.stderr)
        bad = [c for c in checks if not c["ok"]]
        if bad:
            code = min(c["code"] for c in bad)
            raise Fail(code, "; ".join(c["cause"] for c in bad), " / ".join(dict.fromkeys(c["fix"] for c in bad)))
        if not a.dry_run:
            reason = "board-done: " + ", ".join(f"{c['kind']}={c['path']}" for c in checks)
            r = bd("close", a.card_id, "--reason", reason, "--json", actor=a.actor)
            if r.returncode != 0 or "cannot close" in (r.stdout + r.stderr):
                raise Fail(EXIT_CLOSE, f"bd close 실패: {(r.stderr or r.stdout).strip()[:300]}", "메시지 원인 해소 뒤 다시 실행")
        out.update(ok=True, closed=not a.dry_run, exit=EXIT_OK)
        if a.epic and not a.dry_run:
            # 사용자 최종 검수 대기로 표시. 코디네이터는 남겨 검수 답을 받게 함(11-19: 여기서 정리하면 통과·수정 답이 메인 확인 카드로 떨어짐)
            bd("label", "add", a.card_id, "stage:review", actor=a.actor)
            out["feature_close"] = "보류: 검수 통과(--user-ok)와 반영(--shipped) 뒤에 정리"
    except Fail as f:
        out.update(ok=False, closed=False, exit=f.code, cause=f.cause, fix=f.fix)

    if a.json:
        print(json.dumps(out, ensure_ascii=False))
    elif out["ok"]:
        print(f"{'검사 통과(닫지 않음)' if a.dry_run else '닫음'}: {a.card_id} ({out['kind']}) → {a.actor}")
    else:
        for c in out.get("checks", []):
            print(f"  {'통과' if c['ok'] else '불합격'} {c['kind']} {c.get('path', '')}", file=sys.stderr)
        print(f"거부: {out['cause']}\n조치: {out['fix']}", file=sys.stderr)
    sys.exit(out["exit"])


if __name__ == "__main__":
    main()
