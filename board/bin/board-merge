#!/usr/bin/env bash
# 카드 브랜치를 기능 통합 브랜치에 들이는 유일한 경로. 범위 검사 → 완료 게이트 사전 검사 → 시험 병합(+검증) → 커밋 → 카드 완료.
# 한 저장소에 한 번에 하나만(잠금). 어느 단계든 실패하면 통합 브랜치를 바꾸지 않고 멈춤.
set -uo pipefail

HERE=$(cd "$(dirname "$(perl -MCwd=realpath -e 'print realpath shift' "${BASH_SOURCE[0]}")")" && pwd -P)
CHECK="$HERE/board-merge-check"
DONE="$HERE/board-done"

usage() {
  cat <<'H'
사용: board-merge <카드> <작업자> [--repo <통합 작업 공간>] [--branch <카드 브랜치>]
  통합 작업 공간(기본 현재 폴더)은 기능 통합 브랜치가 체크아웃돼 있고 깨끗해야 함.
  카드 브랜치는 카드 label branch:<브랜치>. --branch 는 같은 값일 때만 받음(다르면 종료 2).
  범위 검사 기준은 현재 통합 브랜치.
순서:
  1 잠금(<저장소 .git>/board-merge.lock, 다른 병합이 끝날 때까지 대기)
  2 board-merge-check <카드> <브랜치> --base <통합 브랜치>     종료 4면 중단
  3 board-done <카드> <작업자> --dry-run                         증거 불합격이면 중단
  4 git merge --no-ff --no-commit <브랜치> → 검증 명령(있으면) 실행 → 실패면 merge --abort
  5 git commit → 카드에 'board-merge: <병합 커밋>' 기록 → board-done <카드> <작업자>
우회 막기:
  - bd close 로 먼저 닫은 카드(닫힌 사유가 board-done: 이 아님)는 거부(종료 6). bd reopen 뒤 다시 실행
  - git merge 로 먼저 들어간 브랜치는 그 병합 커밋의 첫 부모 대비로 범위를 검사(fast-forward 면 확인 불가로 종료 4)
종료: 0 병합·완료 / 2 사용법·branch: 불일치 / 3 환경(저장소 더러움·브랜치 없음) / 4 범위 밖 / 6 증거 불합격·직접 닫힌 카드 / 7 충돌 / 8 검증 실패 / 9 병합 뒤 완료 실패(병합은 남음, board-merge 다시 실행)
검증 명령: BOARD_MERGE_VERIFY → <BOARD_DIR>/repos.json 의 그 저장소 "merge_verify"(양식 board/repos.example.json). 없으면 경고만.
환경: BOARD_DIR(작업판) BOARD_MERGE_VERIFY(시험 병합 상태에서 돌릴 검증 명령, 예: Roslyn 컴파일) BOARD_MERGE_WAIT(잠금 대기 초, 600)
예:
  board-merge lrm-12 ui-worker --repo ~/orca/workspaces/LoveRevolutionMaker/coord-feat-store
  BOARD_MERGE_VERIFY='bash Tools/compile.sh' board-merge lrm-12 ui-worker
H
}

die() { echo "오류: $1" >&2; exit "${2:-3}"; }

CARD="" ACTOR="" REPO="." BRANCH=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --repo) REPO="${2:?--repo 값 필요}"; shift 2 ;;
    --branch) BRANCH="${2:?--branch 값 필요}"; shift 2 ;;
    -*) die "알 수 없는 옵션 '$1'. board-merge --help 참고" 2 ;;
    *) if [ -z "$CARD" ]; then CARD="$1"; elif [ -z "$ACTOR" ]; then ACTOR="$1"; else die "인자가 많음: '$1'" 2; fi; shift ;;
  esac
done
[ -n "$CARD" ] && [ -n "$ACTOR" ] || { usage >&2; exit 2; }
BOARD="${BOARD_DIR:-$HOME/orca/board}"

REPO=$(cd "$REPO" 2>/dev/null && pwd -P) || die "저장소 폴더 없음"
git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || die "$REPO 는 git 저장소가 아님"
INTO=$(git -C "$REPO" symbolic-ref --short -q HEAD) || die "$REPO 가 브랜치에 있지 않음(detached). 통합 브랜치를 체크아웃"

# 카드: 상태·닫힌 사유·branch: label·board-merge 기록
CARD_INFO=$(cd "$BOARD" && { bd show "$CARD" --json; echo; bd comments "$CARD" --json 2>/dev/null; } | python3 -c '
import json, sys
docs, dec, s = [], json.JSONDecoder(), sys.stdin.read().strip()
while s:
    v, i = dec.raw_decode(s); docs.append(v); s = s[i:].strip()
d = docs[0][0] if isinstance(docs[0], list) else docs[0]
br = ([l[7:] for l in d.get("labels") or [] if l.startswith("branch:")] or [""])[-1]
rec = [c.get("text", "").split()[1] for c in (docs[1] if len(docs) > 1 else []) or [] if (c.get("text") or "").startswith("board-merge: ")]
print(d.get("status", ""), br or "-", (rec or ["-"])[-1], (d.get("close_reason") or "-").replace(" ", "_")[:40])
' 2>/dev/null) || die "카드 $CARD 를 못 읽음. BOARD_DIR·카드 id 확인"
read -r STATUS LABEL_BRANCH RECORDED CLOSE_REASON <<<"$CARD_INFO"
[ "$LABEL_BRANCH" != - ] || die "카드 $CARD 에 branch: label 없음. bd label add $CARD branch:<브랜치> 뒤 다시 실행" 2
[ -z "$BRANCH" ] || [ "$BRANCH" = "$LABEL_BRANCH" ] \
  || die "--branch $BRANCH 가 카드 label branch:$LABEL_BRANCH 와 다름(증거는 label 브랜치 것). 브랜치가 바뀌었으면 label 을 고치고 증거를 다시 만듦" 2
BRANCH=$LABEL_BRANCH
git -C "$REPO" rev-parse -q --verify "$BRANCH^{commit}" >/dev/null || die "브랜치 $BRANCH 없음"

if [ "$STATUS" = closed ]; then
  case "$CLOSE_REASON" in
    board-done:*) git -C "$REPO" merge-base --is-ancestor "$BRANCH" HEAD && { echo "이미 완료: $CARD ($BRANCH → $INTO)"; exit 0; }
      die "$CARD 는 board-done 으로 닫혔지만 $BRANCH 가 $INTO 에 없음. bd reopen $CARD 뒤 다시 실행" 6 ;;
    *) die "$CARD 는 완료 게이트 없이 닫힘(사유: ${CLOSE_REASON//_/ }). bd reopen $CARD 뒤 board-merge 로 다시 실행" 6 ;;
  esac
fi

# 1 잠금: mkdir 은 원자적. 소유 pid 가 죽었으면 회수
LOCK="$(git -C "$REPO" rev-parse --absolute-git-dir)/board-merge.lock"
waited=0
until mkdir "$LOCK" 2>/dev/null; do
  owner=$(cat "$LOCK/pid" 2>/dev/null)
  # 죽은 잠금 회수는 mv 로 이름을 바꾼 한 명만 지움(둘이 동시에 회수해 둘 다 잡는 경쟁 방지)
  if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null && mv "$LOCK" "$LOCK.stale.$$" 2>/dev/null; then rm -rf -- "${LOCK:?}.stale.$$"; continue; fi
  [ "$waited" -ge "${BOARD_MERGE_WAIT:-600}" ] && die "병합 잠금 대기 초과($LOCK, pid ${owner:-?}). 다른 병합 확인"
  sleep 2; waited=$((waited + 2))
done
echo $$ > "$LOCK/pid"
trap 'rm -rf -- "${LOCK:?}"' EXIT
# 작업 트리 검사는 잠금 안에서: 앞 병합의 시험 병합 상태를 '더러움'으로 오판하지 않게
[ -z "$(git -C "$REPO" status --porcelain --untracked-files=no)" ] || die "$REPO 에 커밋 안 된 변경 있음. 정리 뒤 다시 실행"

# 시험 병합 검증 명령: BOARD_MERGE_VERIFY → <BOARD_DIR>/repos.json 의 그 저장소 merge_verify. 없으면 경고만
VERIFY="${BOARD_MERGE_VERIFY:-$(BOARD_DIR="$BOARD" python3 "$HERE/../lib/board_config.py" get "$REPO" merge_verify 2>/dev/null)}"
[ -n "$VERIFY" ] || echo "경고: $REPO 의 병합 검증 설정 없음 → 시험 병합 뒤 컴파일 안 함. 켜기: $BOARD/repos.json 에 \"merge_verify\"(양식 board/repos.example.json)" >&2

# 이미 들어간 브랜치: board-merge 기록이 있으면 완료만(종료 9 재실행), 없으면 git merge 직접 병합 → 들인 병합 커밋의 첫 부모 대비로 검사
BASE=$INTO ALREADY=0
if git -C "$REPO" merge-base --is-ancestor "$BRANCH" HEAD; then
  ALREADY=1
  if [ "$RECORDED" != - ] && git -C "$REPO" merge-base --is-ancestor "$RECORDED" HEAD 2>/dev/null; then
    echo "이미 병합됨(board-merge $RECORDED): $BRANCH → $INTO"
    "$DONE" "$CARD" "$ACTOR" || exit 9
    exit 0
  fi
  intro=""
  for c in $(git -C "$REPO" rev-list --first-parent -n 2000 HEAD); do
    git -C "$REPO" merge-base --is-ancestor "$BRANCH" "$c" || break
    intro=$c
  done
  if [ -z "$intro" ] || [ "$(git -C "$REPO" rev-list --parents -n1 "$intro" | wc -w)" -lt 3 ] \
     || git -C "$REPO" merge-base --is-ancestor "$BRANCH" "$intro^1"; then
    die "$BRANCH 가 board-merge 없이 fast-forward 로 $INTO 에 들어가 범위를 확인할 수 없음. 그 커밋을 되돌린 뒤 board-merge 로 다시 실행" 4
  fi
  BASE=$(git -C "$REPO" rev-parse "$intro^1")
  echo "경고: $BRANCH 는 board-merge 없이 병합됨(${intro:0:12}). 그 병합 전($INTO 첫 부모 ${BASE:0:12}) 대비로 검사" >&2
fi

# 2 범위 검사
"$CHECK" "$CARD" "$BRANCH" --base "$BASE" --repo "$REPO"; rc=$?
[ "$rc" = 0 ] || { echo "중단: 범위 검사 종료 $rc" >&2; exit "$([ "$rc" = 4 ] && echo 4 || echo 3)"; }

# 3 증거 사전 검사(병합 전에 거르기)
"$DONE" "$CARD" "$ACTOR" --dry-run || { echo "중단: 완료 증거 불합격. 증거 보완 뒤 다시 실행" >&2; exit 6; }

record() { (cd "$BOARD" && bd comments add "$CARD" "board-merge: $1 $BRANCH → $INTO" >/dev/null 2>&1) || echo "경고: 카드 $CARD 에 병합 기록 실패" >&2; }

if [ "$ALREADY" = 1 ]; then
  if [ -n "$VERIFY" ] && ! (cd "$REPO" && bash -c "$VERIFY"); then
    die "검증 실패(병합 검증 명령). 이미 들어간 병합 ${intro:0:12} 을 확인" 8
  fi
  record "$intro"
  "$DONE" "$CARD" "$ACTOR" || exit 9
  exit 0
fi

# 4 시험 병합 + 검증
if ! git -C "$REPO" merge --no-ff --no-commit "$BRANCH" >/dev/null 2>&1; then
  git -C "$REPO" merge --abort 2>/dev/null
  die "$BRANCH → $INTO 충돌. 작업자가 $INTO 를 받아 해결한 뒤 다시 실행" 7
fi
if [ -n "$VERIFY" ]; then
  if ! (cd "$REPO" && bash -c "$VERIFY"); then
    git -C "$REPO" merge --abort
    die "검증 실패(병합 검증 명령). 병합 취소, $INTO 그대로" 8
  fi
fi

# 5 커밋 → 기록 → 카드 완료
git -C "$REPO" commit -q --no-edit || { git -C "$REPO" merge --abort 2>/dev/null; die "병합 커밋 실패(훅 거부 등). 병합 취소" 3; }
MERGED=$(git -C "$REPO" rev-parse HEAD)
echo "병합: $BRANCH → $INTO (${MERGED:0:7})"
record "$MERGED"
"$DONE" "$CARD" "$ACTOR" || { echo "오류: 병합은 됐지만 카드 완료 실패. 원인 해소 뒤 board-merge $CARD $ACTOR 다시 실행" >&2; exit 9; }
