#!/usr/bin/env python3
"""작업판 카드 집기. 다른 진행 중 카드와 고칠 파일(label file:<경로>)이 겹치면 거부함.
겹침 검사~집기는 작업판 잠금(fcntl.flock) 안에서 한 번에 함. 두 작업자가 동시에 같은 파일을 집는 경쟁 방지."""
import argparse
import fcntl
import json
import os
import subprocess
import sys
from datetime import datetime, timezone

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import board_beat as bb  # noqa: E402
import board_flow as bf  # noqa: E402
import board_scope as bs  # noqa: E402

EPILOG = """\
file: 표기는 ~/·상대·./·끝 / 가 섞여도 같은 경로로 맞춘 뒤 '/' 경계로 비교함(file:src/a 는 src/ab 와 안 겹침).
겹침은 (저장소, 저장소 안 경로) 로 비교함. 저장소는 origin 주소 → 공통 git 폴더 순으로 알아내므로
작업자마다 repo: 가 다른 작업 공간(worktree·clone)이어도 같은 저장소의 같은 파일이면 겹침.
상대 경로는 --repo(기본: 카드 label repo:<경로>) 기준이고, 둘 다 없으면 거부(종료 2).
사용자 검수 대기(label stage:review) 가 REVIEW_WIP_MAX(기본 3)개 이상이면 새 착수만 거부(종료 14).
이미 집은 카드 다시 집기와 검수 대기 기능(epic)의 하위 카드는 예외.
겹친 카드가 STALE_HOURS(기본 2)시간 넘게 갱신(heartbeat 포함)이 없으면 '해제 후보' 경고를 함께 냄. 자동 해제는 하지 않음.

카드 설명에 '## 지시(사용자 원문 + 뒤 지시)' 칸(또는 '사용자 … 원문: …' 줄)이 비어 있으면 새로 집지 않음.
새 흐름 기능(기능 카드 label flow:v1)의 구현 카드는 크기(size:small|normal|large)를 정한 뒤, 보통·큼이면 계획 승인 뒤에만 집음(종료 15).
계획 승인 = 그 기능의 계획 승인 카드에 사용자가 Slack 에서 승인으로 답한 것. 규칙은 lib/board_flow.py 한 곳.

종료 코드: 0 집음 · 2 사용법·file: label 없음·지시 칸 비어 있음 · 3 파일 겹침 · 4 환경(bd 실패) · 13 이미 다른 작업자가 집음 · 14 검수 대기 상한
          15 계획 승인 전(또는 크기 미정)
예:
  board-claim lrm-12 ui-worker
  board-claim lrm-12 ui-worker --repo ~/orca/LoveRevolutionMaker
환경: BOARD_DIR(기본 ~/orca/board) STALE_HOURS(2)
"""


def bd(*args, actor=None):
    env = dict(os.environ)
    if actor:
        env["BD_ACTOR"] = actor
    return subprocess.run(["bd", *args], capture_output=True, text=True, env=env, stdin=subprocess.DEVNULL)


def bd_json(*args):
    r = bd(*args, "--json")
    if r.returncode != 0:
        die(f"실패: bd {' '.join(args)}: {r.stderr.strip()[:200]}. 조치: BOARD_DIR·bd 설치 확인", 4)
    try:
        return json.loads(r.stdout or "[]")
    except json.JSONDecodeError:
        die(f"실패: bd {' '.join(args)} 출력이 JSON 아님. 조치: bd 버전 확인", 4)


def die(msg, code):
    print(msg, file=sys.stderr)
    sys.exit(code)


def age_hours(card):
    """마지막 갱신 뒤 경과 시간. heartbeat 는 updated_at 을 안 바꾸므로 둘 중 늦은 쪽(없으면 0)"""
    ts = []
    for key in ("heartbeat_at", "updated_at", "started_at", "created_at"):
        try:
            ts.append(datetime.fromisoformat(card[key].replace("Z", "+00:00")))
        except (KeyError, AttributeError, ValueError):
            pass
    return (datetime.now(timezone.utc) - max(ts)).total_seconds() / 3600 if ts else 0.0


def main():
    ap = argparse.ArgumentParser(prog="board-claim", description="작업판 카드 집기(파일 겹침 검사 포함).",
                                 epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("card", help="카드 id")
    ap.add_argument("actor", help="작업자 이름(BD_ACTOR)")
    ap.add_argument("--repo", default="", help="file: 상대 경로의 기준 저장소")
    try:
        a = ap.parse_args()
    except SystemExit as e:
        sys.exit(0 if e.code == 0 else 2)

    board = os.environ.get("BOARD_DIR", os.path.expanduser("~/orca/board"))
    if not os.path.isdir(board):
        die(f"실패: 작업판 폴더 {board} 없음. 조치: BOARD_DIR=<경로> board-claim …", 4)
    os.chdir(board)
    stale = float(os.environ.get("STALE_HOURS", "2"))

    with open(os.path.join(board, ".board-claim.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        shown = bd_json("show", a.card)
        card = shown[0] if isinstance(shown, list) and shown else shown
        if not card:
            die(f"거부: 카드 {a.card} 없음. 조치: bd list 로 id 확인", 2)
        if card.get("status") == "in_progress" and card.get("assignee") not in ("", None, a.actor):
            die(f"거부: {a.card} 는 이미 {card['assignee']} 가 집음", 13)
        if card.get("status") != "in_progress" and card.get("issue_type") != "epic" and not bs.directive(card):
            die(f"거부: {a.card} 에 '## 지시(사용자 원문 + 뒤 지시)' 칸이 비어 있음. 조치: 사용자 원문과 그 뒤 추가 지시를 그대로 옮겨 "
                f"bd update {a.card} -d … 로 채운 뒤 다시 집음(양식 board/templates/card-task.md)", 2)
        epic = None
        if card.get("parent"):
            up = bd_json("show", card["parent"])
            epic = up[0] if isinstance(up, list) and up else up
        hub = os.environ.get("LRM_HUB_DIR") or os.path.expanduser("~/.config/lrm-hubs")
        why = bf.claim_block(card, epic, lambda did: bf.plan_approved(hub, did))
        if why:
            die(f"거부: {why}", 15)
        repo = os.path.expanduser(a.repo or bs.label(card, "repo"))
        raw = bs.labels(card, "file")
        if not raw:
            die(f"거부: {a.card} 에 고칠 파일 label(file:<경로>)이 없음. 조치: bd label add {a.card} file:<경로> 뒤 다시 실행", 2)
        rel = [p for p in raw if not os.path.isabs(os.path.expanduser(p))]
        if rel and not repo:
            die(f"거부: {a.card} 의 상대 경로 file:{rel[0]} 의 기준 저장소를 모름. 조치: bd label add {a.card} repo:<작업 공간 경로> 또는 --repo", 2)
        mine = [bs.locate(p, repo) for p in raw]
        broad = [p for p, loc in zip(raw, mine) if bs.too_broad(loc)]
        if broad:
            die(f"거부: {a.card} 의 file:{broad[0]} 은 저장소 전체 범위(검사가 무의미). 조치: 고칠 폴더·파일로 좁혀 bd label 수정", 2)

        for other in bd_json("list", "--status", "in_progress", "--limit", "0"):
            if other.get("id") == a.card:
                continue
            orepo = os.path.expanduser(bs.label(other, "repo") or repo)
            for op in (bs.locate(p, orepo) for p in bs.labels(other, "file")):
                hit = next((p for p in mine if bs.loc_overlap(p, op)), None)
                if hit:
                    msg = (f"거부: {a.card} 의 {bs.loc_text(hit)} 가 진행 중 카드 {other['id']} 의 {bs.loc_text(op)} 와 겹침. "
                           f"조치: {other['id']} 끝난 뒤 다시 집거나 파일을 나눔")
                    h = age_hours(other)
                    if h > stale:
                        msg += f"\n경고: {other['id']} 는 {h:.1f}시간 갱신 없음 — 해제 후보. 담당({other.get('assignee') or '?'}) 확인 뒤 bd update {other['id']} --status open"
                    die(msg, 3)

        if card.get("status") != "in_progress":
            limit = int(os.environ.get("REVIEW_WIP_MAX", "3"))
            waiting = [c for c in bd_json("list", "--label", "stage:review", "--all", "--limit", "0")
                       if c.get("id") != a.card and "stage:review" in (c.get("labels") or []) and c.get("issue_type") == "epic"]
            if len(waiting) >= limit and card.get("parent") not in {c.get("id") for c in waiting}:
                die(f"거부: 사용자 검수 대기 {len(waiting)}개(상한 {limit}): {', '.join(c['id'] for c in waiting[:5])}. 새 착수는 멈춤 — "
                    f"진행 중 카드와 검수 대기 기능의 수정 카드는 계속함. 조치: 검수가 끝나면 board-done --epic <id> <이름> --user-ok \"<원문>\"", 14)
        r = bd("update", a.card, "--claim", "--json", actor=a.actor)
        if r.returncode != 0:
            die(f"실패: 집기 {r.stderr.strip()[:200]}", 13 if "claim" in r.stderr.lower() else 4)
        try:
            bb.beat(a.card, a.actor)   # 다시 집기에도 갱신 시각을 앞으로 보냄(새로 집을 땐 bd 가 이미 찍음)
        except bb.BeatError as e:
            print(f"경고: {e}", file=sys.stderr)
    print(f"집음: {a.card} → {a.actor}")


if __name__ == "__main__":
    main()
