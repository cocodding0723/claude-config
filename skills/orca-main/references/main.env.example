# orca-main 설정 예시. 실제 파일: ~/.config/lrm-hubs/main.env (비밀 값 넣지 말 것 — 토큰은 별도 env)
PROJECT_NAME="LoveRevolutionMaker"
HUB_ROOT="$HOME/orca/workspaces/LoveRevolutionMaker"   # coord-*-hub 폴더들의 상위
HUB_SCRIPTS="$HOME/.config/lrm-hubs"                   # restart_hub.sh·resume_all.sh·slack_*.sh 위치
ROLES_DIR="$HUB_SCRIPTS/roles"
HANDOFF_FILE="$HUB_SCRIPTS/MAIN-HANDOFF.md"
PANEL_JSON="$HUB_SCRIPTS/panel.json"
SLACK_NOTIFY="$HUB_SCRIPTS/slack_notify.sh"
SLACK_PENDING="$HUB_SCRIPTS/slack_pending.sh"
SLACK_INBOX="$HUB_SCRIPTS/slack-inbox.jsonl"
SLACK_DONE="$HUB_SCRIPTS/slack-done.txt"
TODO_LIST_ID=""            # Slack 할 일 목록 ID
UNITY_SLOT="$HUB_SCRIPTS/unity_slot.sh"
REMOTE_HOST=""             # 원격 맥 주소(없으면 비움)
STALE_MINUTES=60           # 허브 출력 정지 판정
