#!/usr/bin/env bash
# 새 워커를 어디서 띄울지 판정: local | remote. 근거를 stderr 로 출력
set -uo pipefail
# 원격 맥 orca 환경. 내부 주소라 설치 때 values.env 의 REMOTE_ENV 로 채움
REMOTE="${REMOTE_ENV:-__REMOTE_ENV__}"
NCPU=$(sysctl -n hw.ncpu)
LOAD=$(sysctl -n vm.loadavg | awk '{print $2}')
FREE=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub("%","",$2);print $2}')
UNITY=$(pgrep -f 'Unity.app/Contents/MacOS/Unity' | wc -l | tr -d ' ')
HEAVY="${1:-}"   # 'unity' 를 주면 Unity 작업
# 허브당 동시 구현 워커 상한(11-16 개정). 워커는 대부분 모델 응답 대기라 CPU 부하 평균으로 막지 않음. 메모리 여유가 기준, 부하는 부하는 기준에서 뺌(OS 가 스케줄)
CAP=$(awk -v l="$LOAD" -v n="$NCPU" -v f="${FREE:-50}" 'BEGIN{ if (f<10) print 0; else if (f<20) print 12; else print 25 }')
reason="load=$LOAD/$NCPU free=${FREE:-?}% unity=$UNITY 구현워커상한=$CAP"
busy=0
awk -v l="$LOAD" -v n="$NCPU" 'BEGIN{exit !(l>=4*n)}' && busy=1
[ -n "${FREE:-}" ] && [ "$FREE" -lt 20 ] && busy=1
[ "$HEAVY" = unity ] && [ "$UNITY" -ge 1 ] && busy=1
if [ "$busy" = 1 ] && orca --environment "$REMOTE" status --json 2>/dev/null | grep -q '"reachable": true'; then
  echo "remote"; echo "$reason → 원격($REMOTE)" >&2
else
  echo "local"; echo "$reason → 로컬" >&2
fi
