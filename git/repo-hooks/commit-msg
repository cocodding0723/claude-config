#!/usr/bin/env bash
# claude-config 저장소 전용 commit-msg. 커밋 메시지에서 AI 공저자·생성 표시 줄을 제거함(11-13 D-CFGAPPLY).
# install.sh 가 이 저장소의 .git/hooks/commit-msg 로 링크함(전역 훅 _chain 이 호출). 이미 push 된 이력은 건드리지 않음.
# 제거 대상: 'Co-Authored-By: …Claude/Anthropic…', 'Generated with …Claude…', 🤖 로 시작하는 줄. 사람 공저자는 유지.
f="$1"
[ -f "$f" ] || exit 0
tmp=$(mktemp "${TMPDIR:-/tmp}/cm.XXXXXX") || exit 0
grep -Eiv '^[[:space:]]*co-authored-by:.*(claude|anthropic)|^[[:space:]]*(🤖.*)?generated with .*claude|^[[:space:]]*🤖' "$f" > "$tmp" || true
# 본문 끝에 남은 빈 줄 정리(주석 줄 제외 후 마지막 내용 뒤)
awk '{l[NR]=$0} END{n=NR; while(n>0 && l[n] ~ /^[[:space:]]*$/) n--; for(i=1;i<=n;i++) print l[i]}' "$tmp" > "$tmp.2"
[ -s "$tmp.2" ] && cat "$tmp.2" > "$f"
rm -f "$tmp" "$tmp.2"
exit 0
